{
  "extends": ["next/core-web-vitals", "prettier"],
  "plugins": ["prettier"],
  "env": {
    "browser": true,
    "es2021": true,
    "node": true
  },
  "rules": {
    "prettier/prettier": [
      "error",
      {
        "singleQuote": false,
        "tabWidth": 2,
        "endOfLine": "auto",
        "trailingComma": "none",
        "bracketSpacing": true
      }
    ],
    "camelcase": "error",
    "no-console": "warn",
    "no-unused-vars": "warn",
    "no-undef": "error"
  }
}
